# LLM Provider 配置
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 备用模型配置
FALLBACK_API_KEY=sk-your-fallback-key
FALLBACK_BASE_URL=https://api.openai.com/v1
FALLBACK_MODEL=gpt-3.5-turbo

# 加密密钥（用于API Key加密存储，生产环境务必替换）
ENCRYPTION_KEY=

# 语义缓存配置
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=10000

# 摘要压缩配置
SUMMARY_TOKEN_THRESHOLD=4000
SUMMARY_TARGET_RATIO=0.4

# RAG 知识库配置
RAG_ENABLED=true
RAG_TOP_K=3
RAG_MIN_SCORE=0.3

# LangGraph Agent 配置
AGENT_MAX_QUESTIONS=15
AGENT_RECURSION_LIMIT=10
AGENT_ENABLE_TOOLS=true

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ai-agent-interviewer

# 服务配置
HOST=0.0.0.0
PORT=8000

# ═══════════════════════════════════════════════════════════════════
#  刷题助手（PostgreSQL + pgvector 知识库）
# ═══════════════════════════════════════════════════════════════════
# PostgreSQL 连接串（SQLAlchemy 风格）：
#   使用 psycopg 驱动（纯 Python + binary 可选，Windows 兼容性好）
#   建库：CREATE DATABASE interview_helper;
#   进入库后：CREATE EXTENSION IF NOT EXISTS vector;
# 注意：密码里若包含 @ : # / ? 等特殊字符，按 RFC 3986 做 URL 编码，如 @ -> %40
POSTGRES_DSN=postgresql+psycopg://postgres:postgres@localhost:5432/interview_helper

# Hugging Face 模型下载镜像；国内默认建议用 hf-mirror.com；海外可删或改官方：
# HF_ENDPOINT=https://huggingface.co
HF_ENDPOINT=https://hf-mirror.com

# Embedding 后端：
#   sentence_transformers   ← 默认，免 Key，本地跑 Sentence-BERT（推荐先直接用）
#   openai                  ← 走 OPENAI_API_KEY / OPENAI_BASE_URL 的 embedding 接口
QUIZ_EMBEDDING_BACKEND=sentence_transformers

# 仅当 QUIZ_EMBEDDING_BACKEND=sentence_transformers 时生效：
#   all-MiniLM-L6-v2                                  → 384 维，权重 ~80MB，英文好
#   paraphrase-multilingual-MiniLM-L12-v2             → 384 维，权重 ~420MB，多语言（中英都 OK）
QUIZ_SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# 仅当 QUIZ_EMBEDDING_BACKEND=openai 时生效；配合 OPENAI_API_KEY / OPENAI_BASE_URL：
#   text-embedding-3-small  -> 1536 维
#   text-embedding-3-large  -> 3072 维
#   text-embedding-ada-002  -> 1536 维
QUIZ_EMBEDDING_MODEL=text-embedding-3-small

# 向量维度：必须与实际模型严格一致，且只在 quiz_questions 表首次初始化时生效
#   all-MiniLM-L6-v2                              → 384
#   paraphrase-multilingual-MiniLM-L12-v2         → 384
#   text-embedding-3-small (默认) / ada-002        → 1536
#   text-embedding-3-large                         → 3072
# 中途换模型维度：手动 DROP TABLE quiz_questions 让 ensure_schema() 重建即可。
QUIZ_EMBEDDING_DIMENSIONS=384

# 自定义主题（语义检索）返回的题数 & 最低相似度（余弦，0.0~1.0）
QUIZ_TOP_K=10
QUIZ_MIN_SIMILARITY=0.3
# pgvector HNSW 构建时的候选池大小（越大越准，建库越慢；12~64 常见）
QUIZ_INDEX_K=12

# 爬虫配置
QUIZ_CRAWLER_TIMEOUT=30.0
QUIZ_CRAWLER_CONCURRENCY=5
